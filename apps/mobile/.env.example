# Toll-E mobile configuration. Copy to .env.local for local development.
# Everything prefixed EXPO_PUBLIC_ is bundled into the app and visible to anyone who has it,
# so never put secrets (service-role keys, passwords) here. Every value is optional: without
# them the app runs on its bundled dataset, with ads and purchases shown as "not configured".

# --- Toll data backend (Supabase). Anon key only — access is limited by row-level security.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# --- Map tiles. Defaults to OpenFreeMap Positron (free, no key). The map falls back to an
# offline outline of South Africa if tiles cannot load.
EXPO_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/positron

# --- AdMob banner ad unit ids (production only; development always uses Google test ads).
EXPO_PUBLIC_ADMOB_BANNER_ANDROID=
EXPO_PUBLIC_ADMOB_BANNER_IOS=

# --- RevenueCat public SDK keys (these are designed to be public).
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=

# --- Feature flags.
# Offer the once-off "remove ads" purchase. Leave off until the Play Console product
# tolle_ad_free_lifetime and RevenueCat are set up and a licence-tester purchase has succeeded
# (docs/monetisation.md). While off, no purchase or restore controls are shown.
EXPO_PUBLIC_ENABLE_PURCHASES=false
# Also offer popular routes whose plaza sequence is not yet verified, labelled as such.
# Set by the development, preview and closed-test EAS profiles; never in production.
EXPO_PUBLIC_SHOW_UNVERIFIED_JOURNEYS=false

# --- Contact and legal pages.
EXPO_PUBLIC_SUPPORT_EMAIL=
EXPO_PUBLIC_PRIVACY_POLICY_URL=
EXPO_PUBLIC_TERMS_URL=

# --- Build-time only (read by app.config.ts, not bundled as runtime config).
# ADMOB_ANDROID_APP_ID=ca-app-pub-xxxxxxxxxxxxxxxx~yyyyyyyyyy
# ADMOB_IOS_APP_ID=ca-app-pub-xxxxxxxxxxxxxxxx~zzzzzzzzzz
